---
import styles from './ServiceBlock.module.css';

interface Props {
  heading: string;
  items: string[];
  ctaText: string;
  ctaHref: string;
  imageSrc?: string;
  imageAlt?: string;
  reversed?: boolean;
}

const { heading, items, ctaText, ctaHref, imageSrc, imageAlt = '', reversed = false } = Astro.props;
---
<div class={styles.block}>
  <div class={`${styles.inner} ${imageSrc ? styles.withImage : ''} ${imageSrc && reversed ? styles.reversed : ''}`}>
    <div class={styles.content}>
      <h3>{heading}</h3>
      <ul class={styles.list}>
        {items.map(item => <li>{item}</li>)}
      </ul>
      <a href={ctaHref} class={styles.cta}>{ctaText}</a>
    </div>
    {imageSrc && (
      <div class={styles.imageWrap}>
        <img src={imageSrc} alt={imageAlt} class={styles.image} />
      </div>
    )}
  </div>
</div>
