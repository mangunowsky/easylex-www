  <div class={styles.inner}>
    <a href={base} class={styles.logo}>Kancelaria Prawna easyLEX</a>
    <nav>
      <ul class={styles.nav}>
        <li><a href={`${base}services`}>Usługi</a></li>
        <li><a href={`${base}information`}>O nas</a></li>
        <li><a href={`${base}schedule`}>Kontakt</a></li>
      </ul>
    </nav>
  </div>
</header>
