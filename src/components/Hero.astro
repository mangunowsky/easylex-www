---
import styles from './Hero.module.css';
const base = import.meta.env.BASE_URL;
---
<section class={styles.hero}>
  <div class={styles.titleWrap}>
    <h1 class={styles.title} id="hero-title">EASYLEX</h1>
  </div>

<script>
  function scaleHeroTitle() {
    const el = document.getElementById('hero-title') as HTMLElement;
    if (!el) return;
    const wrap = el.parentElement as HTMLElement;
    el.style.fontSize = '100px';
    const wrapStyle = getComputedStyle(wrap);
    const padLeft = parseFloat(wrapStyle.paddingLeft);
    const padRight = parseFloat(wrapStyle.paddingRight);
    const targetWidth = wrap.getBoundingClientRect().width - padLeft - padRight;
    const ratio = targetWidth / el.getBoundingClientRect().width;
    el.style.fontSize = Math.floor(100 * ratio) + 'px';
  }
  scaleHeroTitle();
  window.addEventListener('resize', scaleHeroTitle);
</script>
  <div class={styles.inner}>
    <div class={styles.content}>
      <img
        class={styles.image}
        src={`${base}images/unsplash-image-VviFtDJakYk.webp`}
        alt="Budynek biurowy"
        width="700"
        height="560"
      />
      <div class={styles.text}>
        <h3>Obsługa prawna dla ambitnych przedsiębiorców</h3>
        <p>
          Nasz zespół tworzą doświadczeni prawnicy, specjalizujący się w obsłudze firm.
          Łączy nas pasja i zaangażowanie w sprawy naszych Klientów. Stawiamy na
          indywidualne podejście i budowanie długotrwałych relacji.
        </p>
        <a href={`${base}information`}>→ o nas</a>
      </div>
    </div>
  </div>
</section>

