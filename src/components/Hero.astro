---
import styles from './Hero.module.css';
const base = import.meta.env.BASE_URL;
---
<section class={styles.hero}>
  <div class={styles.inner}>
    <h1 class={styles.title}>EASYLEX</h1>
    <div class={styles.content}>
      <img
        class={styles.image}
        src={`${base}images/unsplash-image-VviFtDJakYk.webp`}
        alt="Budynek biurowy"
        width="700"
        height="560"
      />
      <div class={styles.text}>
        <h3>Obsługa prawna dla ambitnych przedsiębiorców</h3>
        <p>
          Nasz zespół tworzą doświadczeni prawnicy, specjalizujący się w obsłudze firm.
          Łączy nas pasja i zaangażowanie w sprawy naszych Klientów. Stawiamy na
          indywidualne podejście i budowanie długotrwałych relacji.
        </p>
        <a href={`${base}information`}>→ o nas</a>
      </div>
    </div>
  </div>
</section>
