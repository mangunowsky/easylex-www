---
import styles from './Footer.module.css';
const base = import.meta.env.BASE_URL;
---
<footer class={styles.footer}>
  <div class={styles.top}>
    <div class={styles.cta}>
      <p class={styles.ctaHeading}>Podaj nam Twój numer telefonu</p>
      <p class={styles.ctaSub}>Porozmawiajmy o Twoim Biznesie</p>
      <form
        class={styles.phoneForm}
        action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID"
        method="POST"
      >
        <input
          type="tel"
          name="phone"
          placeholder="Twój numer telefonu"
          aria-label="Numer telefonu"
        />
        <button type="submit">Działajmy</button>
      </form>
      <p class={styles.privacy}>Szanujemy Twoją prywatność</p>
    </div>

    <div class={styles.phone}>
      531 769 909
    </div>

    <div class={styles.nav}>
      <p class={styles.navHeading}>easyLEX</p>
      <ul>
        <li><a href={`${base}services`}>Usługi</a></li>
        <li><a href={`${base}information`}>O Nas</a></li>
        <li><a href={`${base}schedule`}>Kontakt</a></li>
      </ul>
    </div>
  </div>

  <div class={styles.wordmarkWrap}>
    <div class={styles.wordmark} id="footer-wordmark">EASYLEX</div>
  </div>

  <div class={styles.bottom}>
    <p>© {new Date().getFullYear()} Kancelaria Prawna easyLEX</p>
  </div>
</footer>

<script>
  function scaleWordmark() {
    const el = document.getElementById('footer-wordmark') as HTMLElement;
    if (!el) return;
    const wrap = el.parentElement as HTMLElement;
    el.style.fontSize = '100px';
    el.style.transform = '';
    const targetWidth = document.documentElement.clientWidth;
    const ratio = targetWidth / el.getBoundingClientRect().width;
    el.style.fontSize = Math.floor(100 * ratio) + 'px';
  }
  scaleWordmark();
  window.addEventListener('resize', scaleWordmark);
</script>
