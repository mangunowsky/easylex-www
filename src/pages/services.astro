---
import Layout from '../layouts/Layout.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Usługi">
  <div style="padding: var(--section-padding) 0;">
    <div class="container">
      <h2>Obsługa prawna firm</h2>
      <p style="max-width: 640px; margin-top: 24px; margin-bottom: 40px;">
        W naszej kancelarii specjalizujemy się w kompleksowej obsłudze prawnej firm.
        Niezależnie od branży, dostosowujemy nasze rozwiązania tak, aby spełniały Twoje
        oczekiwania. Nasze podejście jest elastyczne i nieszablonowe – stawiamy na
        efektywność i konkretne wyniki.
      </p>
      <a
        href={`${base}schedule`}
        style="font-family: var(--font-heading); font-weight: 700; font-size: 14px; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: underline; color: var(--color-heading);"
      >
        Rozpocznijmy rozmowę o współpracy
      </a>
    </div>
  </div>

  <ServiceBlock
    heading="Stała obsługa prawna"
    items={[
      'Stały dostęp do ekspertów – zapewniamy Klientom bieżącą pomoc prawną pozwalając im skupić się na rozwoju ich Biznesu',
      'Stała umowa pozwala na przewidzenie miesięcznych kosztów obsługi prawnej, co ułatwia planowanie budżetu',
      'Indywidualne podejście i zrozumienie biznesu – prawnicy mający stały kontakt z firmą lepiej rozumieją jej specyfikę',
      'Priorytetowe traktowanie i szybkość reakcji – klienci posiadający stałą umowę otrzymują priorytetowy dostęp do usług',
      'Minimalizacja ryzyka – prawnicy monitorują zmiany w prawie, co pomaga minimalizować ryzyko i unikać problemów',
    ]}
    ctaText="Rozpocznijmy rozmowę o współpracy"
    ctaHref={`${base}schedule`}
    imageSrc={`${base}images/WhatsApp Image 2026-04-29 at 12.21.57.jpeg`}
    imageAlt="Wieżowce biznesowe"
  />

  <ServiceBlock
    heading="Pomoc w Twojej sprawie"
    items={[
      'Prawo cywilne',
      'Sprawy rodzinne',
      'Rozwody',
      'Odszkodowania',
    ]}
    ctaText="Porozmawiajmy o Twojej sprawie"
    ctaHref={`${base}schedule`}
    imageSrc={`${base}images/WhatsApp Image 2026-04-29 at 12.33.30.jpeg`}
    imageAlt="Wieżowiec we mgle"
    reversed={true}
  />

  <ServiceBlock
    heading="Ubezpieczenie prawne"
    items={[
      'Atrakcyjne warunki współpracy',
      'Wsparcie w wymiarze dopasowanym do potrzeb',
      'Szeroki zakres wsparcia',
      'Dostęp do ekspertów',
    ]}
    ctaText="Porozmawiajmy o pakiecie"
    ctaHref={`${base}schedule`}
    imageSrc={`${base}images/WhatsApp Image 2026-04-29 at 12.31.39.jpeg`}
    imageAlt="Fasada budynku"
  />

  <ServiceBlock
    heading="Pakiety dokumentów"
    items={[
      'Każda firma, bez względu na wielkość, potrzebuje sprawdzonych wzorów umów',
      'Oferujemy pakiety wzorów umów adresujących potrzeby przedsiębiorstw, dostępne od ręki',
      'Gotowe rozwiązania pozwalają skupić się na tym, co naprawdę ważne – rozwoju biznesu',
    ]}
    ctaText="Wybierz Twój pakiet"
    ctaHref={`${base}schedule`}
  />
</Layout>
